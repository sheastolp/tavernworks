[Unit]
Description=AI Pool coordinator — control page and status for the pooled model (M3)
After=network-online.target tailscaled.service
Wants=network-online.target

[Service]
Type=simple
Environment=POOL_DIR=/root/ai-pool
ExecStart=/usr/bin/python3 /opt/ai-pool/pool-coordinator.py
Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target
