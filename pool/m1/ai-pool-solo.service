[Unit]
Description=AI Pool solo — llama-server on the FX705 alone (GPU + CPU layers)
After=network-online.target tailscaled.service
Wants=network-online.target
Conflicts=ai-pool-host.service

[Service]
Type=simple
ExecStart=/opt/ai-pool/fx705-solo.sh
Restart=on-failure
RestartSec=15

[Install]
WantedBy=multi-user.target
