<?xml version="1.0" encoding="utf-8"?>
<!-- Wide: Rosin on the left, and while Rosin talks a bubble on the right, tail pointing back at Rosin. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:gravity="center_vertical">

    <ImageView
        android:id="@+id/face"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="2"
        android:scaleType="fitCenter"
        android:contentDescription="Rosin"
        android:src="@drawable/rosin_normal" />

    <LinearLayout
        android:id="@+id/bubble_box"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="3"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:visibility="invisible">

        <ImageView
            android:layout_width="12dp"
            android:layout_height="18dp"
            android:layout_marginEnd="-2dp"
            android:importantForAccessibility="no"
            android:src="@drawable/bubble_tail_left" />

        <TextView
            android:id="@+id/bubble"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bubble"
            android:ellipsize="end"
            android:maxLines="5"
            android:textColor="#FF2A1308"
            android:textSize="13sp" />
    </LinearLayout>
</LinearLayout>
