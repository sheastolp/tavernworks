<?xml version="1.0" encoding="utf-8"?>
<!-- Tall or square: Rosin fills the widget, and while Rosin talks a bubble floats over the top, tail pointing down. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/face"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitCenter"
        android:contentDescription="Rosin"
        android:src="@drawable/rosin_normal" />

    <LinearLayout
        android:id="@+id/bubble_box"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:orientation="vertical"
        android:visibility="gone">

        <TextView
            android:id="@+id/bubble"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:background="@drawable/bubble"
            android:ellipsize="end"
            android:maxLines="4"
            android:textColor="#FF2A1308"
            android:textSize="13sp" />

        <ImageView
            android:layout_width="18dp"
            android:layout_height="12dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="-2dp"
            android:importantForAccessibility="no"
            android:src="@drawable/bubble_tail_down" />
    </LinearLayout>
</FrameLayout>
